# JFrog Foundations workshop configuration.
#
# Copy this file to .env and fill in the values, or run scripts/setup.sh which
# writes it for you. .env is gitignored and must never be committed.
#
# IMPORTANT: no credentials belong in this file. Your JFrog username, password
# and any access token are held by the JFrog CLI in its own configuration,
# written by "jf config add" during lab 00. This file holds non-secret
# configuration only, so that an accidental "cat .env" in front of the room
# does not leak anything.

# The base URL of the workshop JFrog Platform instance, with no trailing
# slash. Your instructor gives you this on the handout.
# Example shape only, this is not a real instance:
#   https://example.jfrog.io
JF_URL=

# Your assigned JFrog Project key, from the handout. Every resource you create
# during the workshop lives inside this project, and the platform prefixes
# resource names with it automatically.
# Example: user01
JF_PROJECT=

# The name of the JFrog CLI server configuration created in lab 00. Leave the
# default unless you have a reason to change it.
JF_SERVER_ID=workshop

# Names of the virtual repositories you create in lab 01. scripts/setup.sh
# fills these in for you: lab 01 fixes the naming convention and the platform
# applies your project key prefix, so both values are known as soon as your
# project key is. Later labs and the CI workflows read them from here rather
# than having you retype them.
JF_NPM_VIRTUAL_REPO=
JF_DOCKER_REPO=

# The port the sample application listens on inside the Codespace.
PORT=3000
