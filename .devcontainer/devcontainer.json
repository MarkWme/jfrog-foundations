{
  "name": "JFrog Foundations",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // Node 22 LTS. Node 20 reached end of life in April 2026 and is no longer
      // among the maintained variants of this image, so it stops receiving
      // security patches. Shipping attendees an unpatched base is a poor look
      // for a supply chain security workshop. This deviates from SPEC.md
      // section 5, which predates Node 20's EOL. See PLAN.md divergence D9.
      //
      // Note this is the DEVCONTAINER base. The deliberately old base image is
      // in apps/node-dashboard/Dockerfile and is teaching material.
      "NODE_VARIANT": "1-22-bookworm",
      "JF_CLI_VERSION": "2.120.0"
    }
  },

  // docker-in-docker is required by the CI and container scanning labs, which
  // build and inspect an image from inside the Codespace. github-cli is used
  // in lab 07 to set repository secrets without leaving the terminal.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "JFrog.jfrog-vscode-extension",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": false,
        "git.openRepositoryInParentFolders": "always"
      }
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Sample application",
      "onAutoForward": "notify"
    }
  },

  // updateContentCommand IS baked into a Codespaces prebuild. postCreateCommand
  // is not. Dependency installation therefore lives in the former, and the
  // latter is limited to the welcome banner and the health check. See
  // docs/repo-setup.md and PLAN.md divergence D3.
  "updateContentCommand": "bash .devcontainer/updateContent.sh",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  // "node", not "vscode". The javascript-node image inherits its non-root user
  // from the official node image and does not contain a "vscode" user, so
  // remoteUser: vscode fails container creation with
  // "unable to find user vscode: no matching entries in passwd file".
  // Confirmed against the image's own upstream definition in
  // github.com/devcontainers/images/src/javascript-node.
  "remoteUser": "node",

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
